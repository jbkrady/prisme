{"name":"Prisme · Ménage","settings":{"timezone":"Europe/Paris","executionOrder":"v1"},"connections":{"Chaque jour à 15 h":{"main":[[{"node":"Effacer les inscriptions non confirmées","type":"main","index":0},{"node":"Effacer les désinscrits","type":"main","index":0}]]},"Effacer les désinscrits":{"main":[[{"node":"Compter les désinscriptions","type":"main","index":0}]]},"Compter les désinscriptions":{"main":[[{"node":"Noter le nombre","type":"main","index":0}]]}},"nodes":[{"parameters":{"rule":{"interval":[{"triggerAtHour":15}]}},"id":"68d993cb627bc738","name":"Chaque jour à 15 h","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.4,"position":[0,0]},{"parameters":{"resource":"row","operation":"deleteRows","dataTableId":{"__rl":true,"mode":"id","value":"VcCRLuKZvRquVPzn"},"matchType":"allConditions","filters":{"conditions":[{"keyName":"statut","condition":"eq","keyValue":"en_attente"},{"keyName":"updatedAt","condition":"lt","keyValue":"={{ $now.minus({ days: 30 }).toUTC().toISO() }}"}]},"options":{}},"id":"932d529838617a8c","name":"Effacer les inscriptions non confirmées","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[260,-100],"alwaysOutputData":true},{"parameters":{"resource":"row","operation":"deleteRows","dataTableId":{"__rl":true,"mode":"id","value":"VcCRLuKZvRquVPzn"},"matchType":"allConditions","filters":{"conditions":[{"keyName":"statut","condition":"eq","keyValue":"desinscrit"}]},"options":{}},"id":"8d33df11e3eaa63d","name":"Effacer les désinscrits","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[260,120],"alwaysOutputData":true},{"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"// Seulement un nombre : aucune adresse ne sort de ce nœud.\nreturn [{ json: { date: $now.setZone('Europe/Paris').toFormat('yyyy-LL-dd'), nombre: $input.all().filter(i => i.json.id !== undefined).length } }];"},"id":"2475e6e248eee7de","name":"Compter les désinscriptions","type":"n8n-nodes-base.code","typeVersion":2,"position":[500,120]},{"parameters":{"resource":"row","operation":"insert","dataTableId":{"__rl":true,"mode":"id","value":"DGSnux38KNmhMo5e"},"columns":{"mappingMode":"defineBelow","value":{"date":"={{ $json.date }}","nombre":"={{ $json.nombre }}"},"matchingColumns":[],"schema":[{"id":"date","displayName":"date","required":false,"defaultMatch":false,"display":true,"type":"string","readOnly":false,"removed":false},{"id":"nombre","displayName":"nombre","required":false,"defaultMatch":false,"display":true,"type":"number","readOnly":false,"removed":false}]},"options":{}},"id":"07eacdef3573f399","name":"Noter le nombre","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[740,120]},{"parameters":{"color":4,"width":520,"height":200,"content":"## Prisme · Ménage\nChaque jour à 15 h (heure de Paris), dans prisme_abonnes :\n- efface les inscriptions « en_attente » de plus de 30 jours (dernière tentative d’inscription) ;\n- efface les désinscrits (adresse effacée dans les 24 h), puis note leur nombre du jour dans prisme_desinscriptions (date, nombre), sans adresse.\nNe touche jamais aux abonnés actifs. Les votes restent, liés à un jeton qui ne mène plus à personne."},"id":"f0c4d429289aada3","name":"Note","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[-40,-340]}]}